package ${ServicePackage};

import ${ModelPackage}.${ModelClassName};
#if(${multiConditionQuery})
import ${ModelPoName};
#end
import ${ModelPackage}.${ModelClassName}Req;
import ${VoPackage}.${VoClassName};
import org.springframework.data.domain.Page;
import org.springframework.web.multipart.MultipartFile;

import java.util.List;

public interface ${ServiceClassName} {

    /**
     * 分页查询后台
     *
     * @param req 查询参数，包含分页信息和查询条件
     * @return 分页查询结果，已转换为VO对象
     */
    Page<${VoClassName}> page(${ModelClassName}Req req);

#if($hasPrimaryKey)
    /**
     * 根据主键查询并转换为VO
     *
#foreach($prop in $primaryKeyProperties)
     * @param ${prop} 主键字段
#end
     * @return VO查询结果
     */
    ${VoClassName} selectByPrimaryKey(${primaryKeyMethodParams});
#end

    /**
     * 根据主键更新
     *
     * @param record 更新的数据对象
     * @return 是否更新成功
     */
    Boolean updateByPrimaryKeySelective(${ModelClassName} record);

    /**
     * 根据条件更新
     *
     * @param updateData 要更新的数据对象
     * @param condition 更新条件
     * @return 影响行数
     */
    int updateByExampleSelective(${ModelClassName} updateData, ${ModelClassName}Req condition);

#if($hasPrimaryKey)
    /**
     * 根据主键删除
     *
#foreach($prop in $primaryKeyProperties)
     * @param ${prop} 主键字段
#end
     * @return 是否删除成功
     */
    Boolean deleteByPrimaryKey(${primaryKeyMethodParams});
#end

    /**
     * 根据条件删除
     *
     * @param condition 删除条件
     * @return 影响行数
     */
    int deleteByExample(${ModelClassName}Req condition);

    /**
     * 新增
     *
     * @param record 新增的数据对象
     * @return 是否新增成功
     */
    Boolean insertSelective(${ModelClassName} record);
    
    /**
     * 批量新增
     *
     * @param records 批量新增的数据对象列表
     * @return 是否新增成功
     */
    Boolean batchInsert(List<${ModelClassName}> records);
    
    /**
     * Excel文件导入处理
     *
     * @param file Excel文件
     * @return 导入结果信息
     * @throws Exception 导入过程中的异常
     */
    String importExcel(MultipartFile file) throws Exception;

}
